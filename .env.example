# Copy to .env; these are local demo placeholders, not real credentials.
COLLECTOR_URL=http://collector:8000/events
EVENT_INTERVAL=5

# Shared application database (Collector, Worker, Alembic, Dashboard, Airflow).
# Airflow/monitoring connection URIs interpolate credentials: use URL-safe values.
POSTGRES_DB=event_data
POSTGRES_USER=event_user
POSTGRES_PASSWORD=change_me_local_only
