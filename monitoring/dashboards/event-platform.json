{
  "id": null,
  "uid": "event-data-platform-operations",
  "title": "Event Data Platform Operations",
  "tags": [
    "event-data-platform",
    "operations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Collector RPS",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0igerm6lfk0a"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"collector\",handler=\"/events\",method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "POST /events",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0igerm6lfk0a"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Collector Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0igerm6lfk0a"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"collector\",handler=\"/events\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0igerm6lfk0a"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"collector\",handler=\"/events\",method=\"POST\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{job=\"collector\",handler=\"/events\",method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0igerm6lfk0a"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "PostgreSQL Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0igerm6lfk0a"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{job=\"postgres\",datname!=\"\",datname!~\"template.*\"}",
          "legendFormat": "{{datname}}",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0igerm6lfk0a"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PostgreSQL Transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0igerm6lfk0a"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\",datname!=\"\",datname!~\"template.*\"}[$__rate_interval])",
          "legendFormat": "{{datname}} commits/s",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0igerm6lfk0a"
          }
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\",datname!=\"\",datname!~\"template.*\"}[$__rate_interval])",
          "legendFormat": "{{datname}} rollbacks/s",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0igerm6lfk0a"
          }
        }
      ]
    },
    {
